{
  "enabled": false,
  "dataset": "CONFIGURE_ON_TRAINING_HOST",
  "output": "analysis/feature-ablation-v1-1",
  "groups": [
    "returns",
    "bar_structure",
    "volume",
    "volatility",
    "trend_position",
    "cross_section",
    "trade_state"
  ],
  "walk_forward": {
    "enabled": true,
    "windows": {
      "minimum_train_timestamps": 1260,
      "validation_timestamps": 252,
      "test_timestamps": 252,
      "step_timestamps": 252,
      "purge_timestamps": 5,
      "embargo_timestamps": 5,
      "minimum_windows": 3
    },
    "model": {
      "ridge_alpha_candidates": [0.1, 1.0, 10.0],
      "normalization_clip": 8.0
    }
  }
}
