{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbt.local/schemas/model_manifest.schema.json",
  "title": "QBT Model Manifest V1/V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_id", "model_version", "model_sha256",
    "feature_profile", "feature_schema_sha256", "calendar_id", "universe_id",
    "data_cutoff_utc", "lookback", "feature_count", "static_feature_count",
    "input_dtype", "input_layout", "outputs", "execution_alignment",
    "onnx_opset", "minimum_runtime_version", "preferred_provider"
  ],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "model_id": {"type": "string", "minLength": 1},
    "model_version": {"type": "string", "minLength": 1},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature_profile": {"enum": ["BAR_V1", "L1_QUOTE_V1", "TRADE_BAR_V1"]},
    "feature_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calendar_id": {"type": "string", "minLength": 1},
    "universe_id": {"type": "string", "minLength": 1},
    "data_cutoff_utc": {"type": "string", "minLength": 1},
    "frequency": {"type": "string", "pattern": "^(1d|[1-9][0-9]*m)$"},
    "lookback": {"type": "integer", "minimum": 1},
    "feature_count": {"type": "integer", "minimum": 1},
    "static_feature_count": {"type": "integer", "minimum": 0},
    "input_dtype": {"const": "float32"},
    "input_layout": {"const": "NTF"},
    "outputs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "unit", "horizon_bars"],
        "properties": {
          "name": {"type": "string"},
          "unit": {"type": "string"},
          "horizon_bars": {"type": "integer", "minimum": 1},
          "quantile": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
        },
        "additionalProperties": false
      }
    },
    "execution_alignment": {"const": "NEXT_OPEN"},
    "onnx_opset": {"type": "integer", "minimum": 17},
    "minimum_runtime_version": {"type": "string", "minLength": 1},
    "preferred_provider": {"const": "CPUExecutionProvider"},
    "model_family": {"type": "string", "minLength": 1},
    "architecture_version": {"type": "string", "minLength": 1},
    "label_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalization_method": {"const": "mean_std"},
    "normalization_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "calibration_method": {"const": "platt_validation_only"},
    "calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "training_dataset_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "leakage_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "minimum_valid_tokens": {"type": "integer", "minimum": 1},
    "dynamic_batch": {"const": true}
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 2}}},
    "then": {"required": [
      "model_family", "architecture_version", "label_spec_sha256",
      "normalization_method", "normalization_sha256", "calibration_method",
      "calibration_sha256", "training_dataset_fingerprint",
      "leakage_report_sha256", "minimum_valid_tokens", "dynamic_batch",
      "frequency"
    ]}
  }]
}
