{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qbt.local/schemas/hypothesis_registry_v1.schema.json",
  "title": "QBT Hypothesis Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sealed_at", "hypotheses", "registry_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "sealed_at": {"type": "string", "format": "date-time"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id", "family_id", "trial_id", "method_version",
          "portfolio_policy_id", "policy_config_hash", "expected_direction",
          "primary_metric", "validation_windows", "p_value_method",
          "created_before_test_at"
        ],
        "properties": {
          "hypothesis_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "family_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "trial_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
          "method_version": {"type": "string", "minLength": 1},
          "portfolio_policy_id": {"type": "string", "minLength": 1},
          "policy_config_hash": {"type": "integer", "minimum": 1},
          "expected_direction": {"enum": ["POSITIVE", "NEGATIVE"]},
          "primary_metric": {"type": "string", "minLength": 1},
          "validation_windows": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "p_value_method": {"type": "string", "minLength": 1},
          "created_before_test_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
